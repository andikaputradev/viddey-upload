PORT=3001
HOST=0.0.0.0
NODE_ENV=production

UPLOAD_API_KEY=generate-a-strong-random-secret-min-32-chars

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHANNEL_ID=-100xxxxxxxxxx
TELEGRAM_API_BASE=https://api.telegram.org

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

NEXT_PUBLIC_SITE_URL=https://viddey.vercel.app

UPLOAD_TEMP_DIR=/tmp/viddey-uploads
CHUNK_SIZE_BYTES=10485760
MAX_FILE_SIZE_BYTES=2147483648
MAX_CONCURRENT_UPLOADS=20
SESSION_TTL_MS=86400000
UPLOAD_RATE_LIMIT=5
CHUNK_RATE_LIMIT=300
CLEANUP_INTERVAL_MS=3600000

CORS_ORIGINS=https://viddey.vercel.app,https://viddey.com
